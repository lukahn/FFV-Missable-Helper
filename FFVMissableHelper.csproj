<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FFVMissableHelper</AssemblyName>
    <RootNamespace>FFVMissableHelper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <!-- Change this if your game lives somewhere else. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\FINAL FANTASY V PR</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
    <!-- NuGet resolves this version of BepInEx's Cpp2IL dependency; pin it to silence NU1603. -->
    <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.13" />
  </ItemGroup>

  <!-- Interop assemblies generated by BepInEx on first launch. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="data\guide.json" LogicalName="FFVMissableHelper.guide.json" />
    <EmbeddedResource Include="data\blue_magic.json" LogicalName="FFVMissableHelper.blue_magic.json" />
    <EmbeddedResource Include="data\items.json" LogicalName="FFVMissableHelper.items.json" />
    <EmbeddedResource Include="assets\*.png" LogicalName="FFVMissableHelper.assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\game\*.png" LogicalName="FFVMissableHelper.assets.game.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\bestiary\*.png" LogicalName="FFVMissableHelper.assets.bestiary.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- `dotnet build -p:DeployToPlugins=true` also copies the plugin into the game. -->
  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(DeployToPlugins)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(GameDir)\BepInEx\plugins" />
  </Target>

  <!-- `dotnet build -p:Package=true` assembles build\package with everything to copy in one go. -->
  <Target Name="PackageAssets" AfterTargets="Build" Condition="'$(Package)' == 'true'">
    <PropertyGroup>
      <PackageDir>$(MSBuildProjectDirectory)\build\package</PackageDir>
      <PackagePluginDir>$(PackageDir)\FFVMissableHelper</PackagePluginDir>
    </PropertyGroup>

    <RemoveDir Directories="$(PackageDir)" />
    <MakeDir Directories="$(PackagePluginDir)\maps" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\data\guide.json" DestinationFolder="$(PackagePluginDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\data\items.json" DestinationFolder="$(PackagePluginDir)" />

    <ItemGroup>
      <MapPictures Include="$(MSBuildProjectDirectory)\maps\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(MapPictures)" DestinationFolder="$(PackagePluginDir)\maps" SkipUnchangedFiles="true" />

    <WriteLinesToFile File="$(PackageDir)\HOW-TO-INSTALL.txt" Overwrite="true" Lines="FFV Missable Helper;==================;Copy everything in this folder into your game's BepInEx\plugins folder, e.g.;;    BepInEx\plugins\FFVMissableHelper.dll;    BepInEx\plugins\FFVMissableHelper\guide.json;    BepInEx\plugins\FFVMissableHelper\maps\*.png;;Replace any existing files. The maps folder contains a zero-byte stub for every;chest/item picture and one map per area; drop your own pictures over the stubs;using the same names, or delete the ones you do not want. Delete guide.json to;fall back to the copy embedded in the DLL." />

    <Message Importance="high" Text="Packaged @(MapPictures->Count()) map files into $(PackageDir)" />
  </Target>

</Project>
